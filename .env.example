# Variable-name reference only. Put real credentials in .env.local locally or in
# the deployment platform's secret manager; never add secrets to this file.
# Public site URL, without a trailing slash. Set the live canonical domain in production.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Delivery fee in pennies (350 = £3.50)
DELIVERY_FEE_PENCE=350
MAX_ORDER_TOTAL_PENCE=100000

# Number of proxies in front of the app that append to x-forwarded-for. Rate limiting
# reads the client address from the right of that chain, so a wrong value here either
# throttles a whole proxy as one client (too low) or trusts a forged entry (too high).
# Vercel, Cloudflare and Fly are detected automatically and ignore this.
TRUSTED_PROXY_COUNT=1

# Signed customer order access. Use a random value of at least 32 characters.
ORDER_ACCESS_SECRET=

# Optional. Lets an uptime monitor read the individual readiness checks from
# /api/health/ready. Without it the checks are visible only to a signed-in
# administrator, and everyone else sees only ready or not_ready.
HEALTH_CHECK_TOKEN=

# Administrator access. Generate the password hash with: pnpm admin:hash -- "your long password"
ADMIN_USERNAME=
ADMIN_PASSWORD_HASH=
ADMIN_SESSION_SECRET=

# Stripe hosted Checkout — use sk_test and whsec test values locally
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Worldpay Hosted Payment Pages. The entity is shown in Worldpay Dashboard >
# Developer Tools and commonly starts with PO. No Checkout ID is used.
WORLDPAY_ENVIRONMENT=try
WORLDPAY_USERNAME=
WORLDPAY_PASSWORD=
WORLDPAY_MERCHANT_ENTITY=
WORLDPAY_NARRATIVE=Malabar Coast
# Preferred production webhook authentication. Worldpay must enable the
# Event-Signature header and provide this shared HMAC secret.
WORLDPAY_WEBHOOK_SECRET=
# Keep false until Try checkout, return queries and signed events pass acceptance.
WORLDPAY_CHECKOUT_ENABLED=false

# Durable order storage (required in production)
SUPABASE_URL=
# Preferred current server-only key (starts with sb_secret_).
SUPABASE_SECRET_KEY=
# Legacy compatibility only. Do not set both server keys.
SUPABASE_SERVICE_ROLE_KEY=
